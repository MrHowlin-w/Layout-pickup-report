{
  "name": "S³ Layout / Pick-Up Report",
  "short_name": "LP Report",
  "description": "Suivi terrain du déploiement et de la récupération des géophones",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "id": "s3-layout-pickup-report",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#060d14",
  "theme_color": "#060d14",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "kmzfile",
          "accept": [
            "application/vnd.google-earth.kmz",
            "application/vnd.google-earth.kml+xml",
            "application/octet-stream",
            "application/zip",
            ".kmz",
            ".kml"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/vnd.google-earth.kmz": [".kmz"],
        "application/vnd.google-earth.kml+xml": [".kml"]
      }
    }
  ]
}
